{
  "manifest_version": 3,
  "name": "银联商务助手",
  "version": "0.2.0",
  "description": "探测银联商务页面，并按当前登录商户运行对账导出。",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://service.chinaums.com/*"
  ],
  "action": {
    "default_title": "银联商务助手",
    "default_popup": "popup.html",
    "default_icon": "favicon.ico"
  },
  "icons": {
    "16": "favicon.ico",
    "32": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  }
}
